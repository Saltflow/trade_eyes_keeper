# 股票量化系统配置文件示例
# 复制为 config/config.yaml 并修改

# ── 公告 ──
announcements:
  days: 7
  dividend_days: 420
  enable: true
  include_in_email: true
  enable_content_fetching: true
  enable_llm_extraction: true
  max_llm_calls_per_run: 30
  max_pdf_size_mb: 10

# ── 财报 ──
financial_reports:
  enable: false
  auto_enable: true
  conditional_enable: true
  force_analyze: false
  max_stocks_per_run: 2
  max_force_stocks: 2
  max_llm_calls_per_run: 80
  reports_per_stock: 3
  conditional_days: 30

# ── 数据源 ──
data_source:
  type: web_crawler
  primary: web_crawler
  secondary: baostock
  etf_force_web_crawler: true
  fallback_to_web_crawler: true

# ── 邮件 (填入你的 SMTP 信息) ──
email:
  enable_ssl: true
  enable_tls: false
  smtp_port: 465
  smtp_server: smtp.your-email-provider.com   # 例如 smtp.gmail.com / smtp.yeah.net

# ── LLM (DeepSeek) ──
llm:
  api_type: deepseek
  base_url: https://api.deepseek.com/v1
  model: deepseek-chat
  enable_fundamental_analysis: true  # LLM 基本面分析，默认开启

# ── 日志 ──
logging:
  file: ./logs/quant_system.log
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
  level: INFO

# ── 调度 ──
scheduler:
  run_time: '19:00'
  cache_bypass_cutoff: '15:55'
  timezone: Asia/Shanghai
  # 服务器繁忙时允许错过整点后补跑；APScheduler 默认约1秒会误跳任务。
  daily_misfire_grace_seconds: 3600
  brief_misfire_grace_seconds: 900
  optimize_misfire_grace_seconds: 7200
  brief_reports:
    - id: morning_snapshot
      run_time: '09:50'
      label: 早盘简报
      stocks: []   # 填入你的股票代码列表

# ── 监控标的 ──
stocks: []           # 填入你的股票代码，例如 [601728, 000001, VOO]

# ── 标的画像审计（不会进入策略搜参）──
instrument_audit:
  output_dir: data/instrument_audit
  timeout_seconds: 20
  show_in_daily_report: true
  enrich_top_holdings: true
  max_holding_profiles_per_fund: 10
  # SEC 要求包含可联系邮箱的 User-Agent；留空时使用 .env 的 EMAIL_SENDER，
  # 也可通过 SEC_USER_AGENT 环境变量显式覆盖。
  sec_user_agent: ""

# Point-in-time statements, raw/qfq prices and corporate actions (strategy opt-in)
point_in_time_data:
  output_dir: data/point_in_time
  # 84-month walk-forward history plus the optimizer's six-month calendar buffer.
  history_years: 9
  official_statement_crawlers: true
  official_pdf_recent_years: 3
  # Required by the HKD value-policy example when an H share reports in CNY.
  # This is market data only; it never enters the configured equity universe.
  fx_symbols: [CNYHKD=X]
  # Beta benchmarks for the opt-in HK/US value policies.  They are stored as
  # market-only series, never mistakenly audited as company fundamentals.
  market_only_symbols: ["02800", VOO]
  hkex_max_reports_per_code: 36
  cninfo_pdf_cache_dir: data/point_in_time/provider_cache/cninfo
  market_history:
    compare_fallback_on_partial: true
    prefer_explainable_actions: true
    coverage_tolerance_days: 31
    baostock_socket_timeout_seconds: 20


# 发行人接口彼此不统一；可按代码声明官方资料和持仓CSV。
# instrument_catalog:
#   VOO:
#     instrument_type: index_etf
#     issuer: Vanguard
#     tracking_index: S&P 500
#     asset_class: equity
#     holdings_url: https://issuer.example/holdings.csv
#     holdings_as_of: 2026-07-31
#     holdings_columns: {code: ticker, name: name, weight: weight}

# ── 策略搜索优化器 ──
optimizer:
  enable: true
  drawdown_limit: -30
  output_dir: ./data/optimizer

  # Optional manual candidate only.  Every selected market requires its own
  # dated statements, raw-price benchmark, risk-free curve and passed frozen
  # broad-universe policy.  Missing evidence closes that market rather than
  # falling back to current fundamentals, a constant rate, or an A-share policy.
  capm_dcf_value:
    equity_risk_premium: 0.06
    beta_margin_gamma: 0.32
    minimum_entry_fraction: 0.75
    maximum_entry_fraction: 0.95
    maximum_snapshot_age_days: 550
    markets:
      a_share:
        data_root: data/reference_universe/point_in_time_20260818/partial_first_pass_20260822/dataset
        market_currency: CNY
        benchmark_prices: cache/data/510300.csv
        industry_history: data/reference_universe/industry_classification_history_official_2020q4_2025h2.json
        risk_free_rates_json: data/analysis/capm_dcf_value_policy_20260825/risk_free_rates_current.json
        frozen_policy_report: data/analysis/capm_dcf_value_policy_20260825/report.json
      # Run --backfill-point-in-time-data first.  The benchmarks below must
      # exist in the same point-in-time market store, and each policy report
      # must be trained on that market's independent broad universe.
      hk:
        data_root: data/point_in_time
        market_currency: HKD
        benchmark_symbol: "02800"
        # A CNY-reporting H share is valued only after this point-in-time FX
        # series is present.  The quote is HKD per CNY; do not use a current FX
        # spot rate to rewrite history.
        currency_conversion_symbols:
          CNY: CNYHKD=X
        # Generate quarterly anchors from the same 02800 price history:
        # python scripts/fetch_capm_dcf_risk_free.py --source hkma_efn_2y \
        #   --data-root data/point_in_time --benchmark-symbol 02800 \
        #   --output data/analysis/capm_dcf_value_policy_hk/risk_free_rates.json
        risk_free_rates_json: data/analysis/capm_dcf_value_policy_hk/risk_free_rates.json
        frozen_policy_report: data/analysis/capm_dcf_value_policy_hk/report.json
      us:
        data_root: data/point_in_time
        market_currency: USD
        benchmark_symbol: VOO
        # python scripts/fetch_capm_dcf_risk_free.py --source us_treasury_10y \
        #   --data-root data/point_in_time --benchmark-symbol VOO \
        #   --output data/analysis/capm_dcf_value_policy_us/risk_free_rates.json
        risk_free_rates_json: data/analysis/capm_dcf_value_policy_us/risk_free_rates.json
        frozen_policy_report: data/analysis/capm_dcf_value_policy_us/report.json

# ── 历史数据缓存 ──
historical_cache:
  enable: true
  historical_cache_days: 30
  force_update_interval_days: 30
  check_dividend_interval_days: 7
  historical_lookback_days: 730
  enable_historical_cache: true

# ── 健康检查服务器 ──
health_server:
  enabled: true
  host: 0.0.0.0
  port: 1933
  ssl: false                            # 是否启用 HTTPS (需自签名证书)
  cert_file: cert.pem                   # SSL 证书路径 (ssl=true 时需提供)
  key_file: key.pem                     # SSL 私钥路径 (ssl=true 时需提供)
  ip_detect_url: https://ifconfig.me    # 公网 IP 检测服务 (报告链接用)

# ── 多层警报系统 ──
alerts:
  config_path: "./config/alerts.yaml"
  enabled: true
