config/.*.tmp

# Local test scratch state
temp_test_cache/
test_cache/
.pytest_*/
.pytest-*/

# Holding area for reversible cleanups (nothing here is deleted outright)
.trash/

# Downloaded point-in-time source data and research datasets are regenerated
# from the tracked backfill/import scripts.  They are too large and too
# provider-specific for the public source repository.
data/point_in_time/
data/reference_universe/
data/server_imports/
data/provider_state/

# Formal research: local execution evidence and disposable test workspaces.
/.tmp/
/data/acceptance/
/data/fundamental_data/
/data/fundamental_quant/*
!/data/fundamental_quant/tokenizer/

# Generated build provenance is runtime state, never a source release.
/data/deployment/

# Local runtime dependencies, source archives, state and generated products.
# Reproducible source fixtures belong under tests/fixtures/, not data/.
/.runtime/
/tmp/
/reports/
/data/*
!/data/fundamental_quant/
/data/fundamental_quant/*
!/data/fundamental_quant/tokenizer/

# Captured audit payloads are local evidence; keep narrative Markdown reports.
/docs/development/audits/**/run/
/docs/development/audits/**/*.json
/docs/development/audits/**/*.html
/docs/development/audits/**/*.pdf
/docs/development/audits/**/*.png
